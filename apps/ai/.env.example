# Internal NestJS AI microservice port (default: 4060)
PORT=4060

# Required shared secret; backend sends this value through x-internal-key
AI_SERVICE_INTERNAL_KEY=

# Optional during development; obtain from platform.openai.com. Missing value uses deterministic fallbacks
OPENAI_API_KEY=

# Optional absolute path to the prompts directory (default: apps/ai/prompts relative to cwd)
# AI_PROMPTS_DIR=

# Optional OpenAI model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
