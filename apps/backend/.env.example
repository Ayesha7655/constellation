# Server
PORT=4050
NODE_ENV=development
# Nest logger levels (comma-separated). Local default when unset: error,warn,log
# LOG_LEVEL=error,warn,log

# Database — update with your PostgreSQL credentials
DATABASE_URL="postgresql://postgres:0000@localhost:5432/constellation?schema=public"
# Optional — set to true to log Sequelize SQL to stdout (dev only)
# SEQUELIZE_LOG_QUERIES=true

# Frontend URL (for CORS)
WEB_URL="http://localhost:4000"

# JWT (use strong secrets in production)
JWT_SECRET=change-me-in-production
REFRESH_TOKEN_SECRET=change-me-refresh-in-production
JWT_ISSUER=constellation
JWT_AUDIENCE=constellation
JWT_EXPIRES_IN=3600s
REFRESH_TOKEN_EXPIRES_IN=2592000s

# Firebase Admin SDK (service account fields from Firebase console)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web API key (Project settings → General → Web API Key)
FIREBASE_WEB_API_KEY=

# Resend (https://resend.com) — auth emails (password reset, verification)
RESEND_API_KEY=
# Optional; defaults to Constellation <onboarding@resend.dev> for local dev
RESEND_FROM_EMAIL=

# Auth action rate limits (forgot-password, reset-password, send/verify email)
AUTH_ACTION_RATE_LIMIT_MAX=10
AUTH_ACTION_RATE_LIMIT_WINDOW_MS=60000

# Dev only — artificial API delay in ms to test loading states (0 in production)
REQUEST_DELAY_MS=0

# Super admin seeder (pnpm db:seed) — dev/staging only; not for production CI
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Optional display name; defaults to "Super Admin"
SUPER_ADMIN_NAME=

# Paginated list endpoints — maximum allowed `limit` query param (default 100)
PAGINATION_MAX_LIMIT=100

# Filter AI microservice (ChatGPT Apify filter generation)
FILTER_AI_URL=http://localhost:4060
FILTER_AI_INTERNAL_KEY=dev-filter-ai-internal-key
# Optional Filter AI request timeout in milliseconds (default: 15000)
FILTER_AI_TIMEOUT_MS=15000
