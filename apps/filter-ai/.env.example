# Internal NestJS microservice port (default: 4060)
PORT=4060

# Required shared secret; backend sends this value through x-internal-key
FILTER_AI_INTERNAL_KEY=

# Optional during development; obtain from platform.openai.com. Missing value uses deterministic fallback filters
OPENAI_API_KEY=

# Optional OpenAI model used for filter generation (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
