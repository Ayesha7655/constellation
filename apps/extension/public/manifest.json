{
  "manifest_version": 3,
  "name": "Constellation Upwork Sync",
  "version": "0.2.0",
  "description": "Sync your logged-in Upwork profiles into Constellation.",
  "key": "",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://*.upwork.com/*",
    "http://localhost:6051/*",
    "http://127.0.0.1:6051/*",
    "http://localhost:6050/*",
    "http://127.0.0.1:6050/*",
    "http://localhost:4050/*",
    "http://127.0.0.1:4050/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:6050/*",
      "http://127.0.0.1:6050/*",
      "http://localhost:4000/*",
      "http://127.0.0.1:4000/*"
    ]
  },
  "action": {
    "default_title": "Constellation",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.upwork.com/*"],
      "js": ["scraper/selectors.js", "scraper/extractor.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
