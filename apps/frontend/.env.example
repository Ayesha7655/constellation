# Frontend port (Next.js dev & production server)
PORT=4000

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:4050/api

# Public site URL for canonical links, sitemap, and robots.txt (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# Onboarding document upload — must match backend ONBOARDING_UPLOAD_API_KEY
NEXT_PUBLIC_ONBOARDING_UPLOAD_API_KEY=dev-onboarding-upload-key-change-me

# i18n — fallback locale when no `locale` cookie is set (en | ar)
NEXT_PUBLIC_DEFAULT_LOCALE=en

# i18n — show locale switcher in header when `true` (default: hidden)
NEXT_PUBLIC_LOCALE_SWITCHER_ENABLED=

# Max child tiers for use case hierarchy in admin UI (match backend USE_CASE_MAX_DEPTH; default 1)
NEXT_PUBLIC_USE_CASE_MAX_DEPTH=1

# Dev only — floating autofill button on forms when `true` (never enable in production)
NEXT_PUBLIC_DEV_FORM_AUTOFILL_ENABLED=

# Dev only — artificial page/API delay in ms to test loading states (0 in production)
NEXT_PUBLIC_REQUEST_DELAY_MS=0

# Default items per page for paginated admin lists (sent to API as `limit`)
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20

# Optional — client-side upload size cap (MB) for evidence/document file pickers.
# Should match the backend UPLOAD_MAX_FILE_SIZE_MB. Defaults to 40 when unset.
NEXT_PUBLIC_UPLOAD_MAX_FILE_SIZE_MB=40

# Firebase Web SDK — local: constellationlocal project (staging/prod use different values)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Stripe — TEST mode publishable key (same account as backend STRIPE_SECRET_KEY)
# https://dashboard.stripe.com/test/apikeys — required for Phase 0 embedded checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
